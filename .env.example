# ==============================================================================
# GreenLedger Environment Configuration
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=production

# Local Windows Agent URL
LOCAL_AGENT_URL=http://127.0.0.1:8765
NEXT_PUBLIC_LOCAL_AGENT_URL=http://127.0.0.1:8765

# Public API URL for Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Carbon Intensity (kg CO2e per kWh)
# Default: 0.385 kg CO2e / kWh (US Average grid emission factor)
CARBON_INTENSITY_KG_PER_KWH=0.385

# Web3 / Ethereum Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Ethereum Sepolia
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
# Private key used ONLY by contracts/hardhat.config.js for Sepolia deployment.
# Never commit a real key — fund a throwaway testnet wallet from a Sepolia faucet.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_PRIVATE_KEY

# Deployment & Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://greenledger.vercel.app
# Set this to the deployed Vercel origin when it differs from the default above.
VERCEL_FRONTEND_URL=https://greenledger.vercel.app
